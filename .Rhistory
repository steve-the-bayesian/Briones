library(Briones)
search()
ls(2)
Briones::sf.districts
y <- rnorm(12)
ls(2)
?SfDistrictMap
SfDistrictMap(y)
y <- data.frame(income = y, district=1:12)
SfDistrictMap(y, district=district)
SfDistrictMap(y, district="district")
y <- rnorm(11)
y <- data.frame(income = y, district=1:11)
y
SfDistrictMap(y, district="district")
SfDistrictMap(y, district="district", title="Some Fake Data To Test The Function")
SfDistrictMap(y, district="district", main="Some Fake Data To Test The Function")
detach(2)
install.packages("~/code/Briones", repos=NULL, type="source")

library(Briones)
SfDistrictMap(y, district="district", main="Some Fake Data To Test The Function")
q()
n
